# AI Interview Agent 2.0 - Environment Configuration
APP_NAME="AI Interview Agent"
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration
# PostgreSQL for production/docker:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_interview_agent
# Local SQLite fallback option for zero-dependency dev:
# DATABASE_URL=sqlite:///./interview_agent.db

# Google Gemini API configuration
# Acquire from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security and Sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

LOG_LEVEL=INFO
